{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://respire.app/schemas/dharana.schema.json",
  "title": "Respire Dharana Collection",
  "description": "The 112 Gates library. Generated by scripts/build_dharanas.py and bundled as <id>.dharanas.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "subtitle", "attribution", "glossary", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "attribution": { "type": "string", "description": "Shown under 'About this synthesis'." },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "meaning", "matches"],
        "properties": {
          "term": { "type": "string" },
          "meaning": { "type": "string", "maxLength": 120 },
          "matches": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z ]+$" },
            "description": "Lowercase fragments; a gate shows the term when its title or text contains one."
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "numeral", "title", "subtitle", "world", "focus", "practice", "dharanas"],
        "properties": {
          "id": { "type": "string" },
          "numeral": { "type": "string", "pattern": "^[IVXLC]+$" },
          "title": { "type": "string" },
          "subtitle": { "type": "string", "maxLength": 90 },
          "world": { "enum": ["aurora", "ocean", "sakura", "desert", "waterfall", "volcano", "rain", "wind", "thunder", "cymatics"] },
          "focus": { "enum": ["calmAnxiety", "focus", "windDown"] },
          "practice": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inhale", "holdFull", "exhale", "holdEmpty", "minutes"],
            "properties": {
              "inhale": { "type": "number", "minimum": 1, "maximum": 20 },
              "holdFull": { "type": "number", "minimum": 0, "maximum": 20 },
              "exhale": { "type": "number", "minimum": 1, "maximum": 20 },
              "holdEmpty": { "type": "number", "minimum": 0, "maximum": 20 },
              "minutes": { "type": "number", "minimum": 1, "maximum": 30 }
            }
          },
          "dharanas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["number", "title", "text"],
              "properties": {
                "number": { "type": "integer", "minimum": 1, "maximum": 112 },
                "title": { "type": "string" },
                "text": { "type": "string", "maxLength": 200, "description": "The practice, verbatim from the source synthesis." },
                "caution": { "type": "string", "maxLength": 200 },
                "level": { "enum": ["foundation", "deepening", "nondual"], "description": "How much the gate asks. Beginners are offered foundations first." }
              }
            }
          }
        }
      }
    }
  }
}
